{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wtw-canon-desk",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wtw-canon-desk-db",
      "database_id": "REPLACE_WITH_WTW_ONLY_D1_UUID",
      "migrations_dir": "migrations"
    }
  ]
}